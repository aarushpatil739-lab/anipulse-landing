# Railway Environment Variables Example
# Copy these to your Railway project settings

# MongoDB Connection (Required)
# Get this from MongoDB Atlas or Railway MongoDB plugin
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/anipulse?retryWrites=true&w=majority

# Database Name (Required)
DB_NAME=anipulse

# CORS Origins (Required)
# Add your Vercel frontend URLs (comma-separated, no spaces)
CORS_ORIGINS=https://anipulse-landing.vercel.app,https://*.vercel.app

# Port (Optional - Railway sets this automatically)
PORT=8000

# Optional: Logging level
LOG_LEVEL=INFO
